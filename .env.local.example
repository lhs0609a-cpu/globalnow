# ─────────────────────────────────────────────────────────────
# 코드에서 실제로 참조하는 키만 담았습니다 (src/ 전수 검사 기준).
# 값이 비어 있어도 빌드·실행은 됩니다 — 해당 기능만 꺼집니다.
# ─────────────────────────────────────────────────────────────

# Supabase — 없으면 앱 전체가 데모 모드로 동작 (로그인/가입/개인화 불가)
#   src/lib/demo/is-demo-mode.ts 의 isDemoMode() 판정 기준
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — 없으면 캐시 없이 매번 원본 호출 (src/lib/redis/cache.ts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI 브리핑 생성 — 둘 다 없으면 /api/cron/generate-brief 무동작
GROQ_API_KEY=
GOOGLE_GEMINI_API_KEY=

# 번역 — 없으면 원문 그대로 노출 (src/lib/ai/translate.ts)
GOOGLE_CLOUD_TRANSLATION_API_KEY=

# 뉴스레터 발송 — 없으면 /api/cron/send-newsletter 무동작
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=

# Reddit 수집기 — 없으면 해당 소스만 건너뜀
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 특허 수집기 — 없으면 해당 소스만 건너뜀
PATENTSVIEW_API_KEY=

# 수집 잡 인증 (Vercel에 등록된 값과 동일해야 함)
CRON_SECRET=
